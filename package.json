{
  "name": "krown",
  "version": "0.1.0",
  "description": "Krown - Centralisateur de sessions SSH",
  "private": true,
  "scripts": {
    "install": "npm run install:all",
    "install:all": "npm run install:frontend && npm run install:backend",
    "install:backend": "cd backend-node && npm install",
    "install:frontend": "cd frontend && npm install",
    "dev": "bash ./scripts/dev.sh",
    "dev:frontend-only": "cd frontend && npm run dev",
    "dev:backend": "cd backend-node && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend-node && npm install",
    "build:frontend": "cd frontend && npm run build",
    "start": "bash ./scripts/start.sh",
    "start:backend": "cd backend-node && npm start",
    "start:frontend": "cd frontend && npm run preview"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
